generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

// Legacy Role enum retained for backward compatibility during Phase 1 migration
enum UserRole {
  OWNER
  STAFF
}

// Modern Multi-User Membership Roles
enum MembershipRole {
  OWNER // مالك المركز: تحكم كامل بالنظام والفريق والاشتراكات
  ADMIN // مدير المركز/الفرع: إدارة العمليات والمخزون والفريق دون إعدادات المالك
  RECEPTIONIST // موظف استقبال: العملاء والمركبات وأوامر الصيانة وعروض الأسعار
  TECHNICIAN // فني صيانة: تنفيذ أوامر الصيانة واستخدام قطع الغيار
  WAREHOUSE // أمين مستودع: المخزون والمستودعات والجرد والحركات
  FINANCE // محاسب: الفواتير والذمم والمصروفات والسندات والإقفال اليومي
  VIEWER // مشاهد: قراءة التقارير والعمليات دون تعديل
}

// Membership Status Lifecycle
enum MembershipStatus {
  ACTIVE // عضو نشط يحق له الوصول
  SUSPENDED // عضو مجمد مؤقتاً بواسطة المالك
  REMOVED // عضو ملغى من المتجر مع الحفاظ على سجل عملياته
}

// Invitation Lifecycle
enum InvitationStatus {
  PENDING // دعوة لم تُقبل بعد
  ACCEPTED // دعوة تم قبولها وانضم الموظف
  REVOKED // دعوة تم إلغاؤها من قبل الإدارة
  EXPIRED // دعوة انتهت صلاحيتها الزمنية
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  REPAIRING
  WAITING_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
  REPAIR_USAGE
  REPAIR_RETURN
  RETURN
}

enum InvoiceType {
  REPAIR
  SALE
  MANUAL
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum InstallmentPlanSource {
  MANUAL
  INVOICE
}

enum InstallmentFrequency {
  WEEKLY
  MONTHLY
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentScheduleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  MARKETING
  TRANSPORT
  MAINTENANCE
  OTHER
}

// BASIC retained only for historical PostgreSQL enum compatibility.
// All new/trial/paid subscriptions use PROFESSIONAL.
enum SubscriptionPlan {
  BASIC
  PROFESSIONAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELED
}

enum SubscriptionBillingInterval {
  SIX_MONTHS
  ANNUAL
}

enum GrowthLifecycleDeliveryStatus {
  PROCESSING
  SENT
  FAILED
}

// ---------------------------------------------------------
// TENANT / BUSINESS MODEL
// ---------------------------------------------------------

model Shop {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  address     String?
  countryCode String    @default("US") @db.VarChar(2)
  currency    String    @default("SAR")
  taxNumber   String?
  taxRate     Decimal   @default(15) @db.Decimal(5, 2)
  terms       String?
  maxSeats    Int       @default(5) // Legacy only; subscription Entitlement Service is authoritative
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  // Relationships
  memberships               Membership[]
  invitations               ShopInvitation[]
  users                     User[] // Legacy direct relation (Phase 1 compatibility)
  customers                 Customer[]
  suppliers                 Supplier[]
  repairOrders              RepairOrder[]
  vehicles                  Vehicle[]      @relation("AutoVehicleShop")
  autoServiceOrders         ServiceOrder[] @relation("AutoServiceOrderShop")
  autoServiceOrderHistories ServiceOrderStatusHistory[] @relation("AutoServiceOrderHistoryShop")
  autoServiceInspections    ServiceInspection[] @relation("AutoServiceInspectionShop")
  autoServiceInspectionItems ServiceInspectionItem[] @relation("AutoServiceInspectionItemShop")
  autoServiceLaborLines ServiceLaborLine[] @relation("AutoServiceLaborShop")
  autoServicePartLines  ServicePartLine[] @relation("AutoServicePartShop")
  warehouses            Warehouse[] @relation("AutoWarehouseShop")
  repairOrderItems          RepairOrderItem[]
  repairStatusHistories     RepairStatusHistory[]
  repairAssignmentHistories RepairOrderAssignmentHistory[]
  inventoryItems            InventoryItem[]
  inventoryMovements        InventoryMovement[]
  sales                     Sale[]
  saleItems                 SaleItem[]
  invoices                  Invoice[]
  payments                  Payment[]
  whatsappTemplates         WhatsAppTemplate[]
  installmentPlans          InstallmentPlan[]
  installmentPayments       InstallmentPayment[]
  paymentSourceOptions      PaymentSourceOption[]
  expenses                  Expense[]
  subscription              Subscription?
  onboardingProfile         ShopOnboardingProfile?
  growthExperimentAssignments GrowthExperimentAssignment[]
  growthLifecyclePreference GrowthLifecyclePreference?
  growthLifecycleDeliveries GrowthLifecycleDelivery[]

  @@index([updatedAt])
  @@index([deletedAt])
  @@index([countryCode])
}

model ShopOnboardingProfile {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @unique @db.Uuid
  flowVersion  Int       @default(1)
  primaryJob   String?   @db.VarChar(40)
  selectedJobs String[]  @default([])
  startedAt    DateTime?
  completedAt  DateTime?
  skippedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([primaryJob])
  @@index([flowVersion, completedAt])
}

model GrowthLifecyclePreference {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @unique @db.Uuid
  emailOptOutAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model GrowthLifecycleDelivery {
  id                String                        @id @default(uuid()) @db.Uuid
  shopId            String                        @db.Uuid
  flowVersion       Int
  kind              String                        @db.VarChar(64)
  triggerKey        String                        @db.VarChar(220)
  status            GrowthLifecycleDeliveryStatus @default(PROCESSING)
  attemptCount      Int                           @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?                       @db.VarChar(160)
  failureCode       String?                       @db.VarChar(80)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, kind, triggerKey])
  @@index([shopId, sentAt])
  @@index([status, lastAttemptAt])
  @@index([kind, createdAt])
}

model GrowthExperimentAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @db.Uuid
  experimentKey  String   @db.VarChar(100)
  variant        String   @db.VarChar(60)
  assignedAt     DateTime @default(now())
  firstExposedAt DateTime?
  lastExposedAt  DateTime?
  exposureCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, experimentKey])
  @@index([experimentKey, variant, firstExposedAt])
  @@index([firstExposedAt])
}

model Subscription {
  id                     String                       @id @default(uuid()) @db.Uuid
  shopId                 String                       @unique @db.Uuid
  plan                   SubscriptionPlan             @default(PROFESSIONAL)
  status                 SubscriptionStatus           @default(TRIALING)
  billingInterval        SubscriptionBillingInterval?
  trialStartedAt         DateTime
  trialEndsAt            DateTime
  currentPeriodStartedAt DateTime?
  currentPeriodEndsAt    DateTime?
  activatedAt            DateTime?
  canceledAt             DateTime?
  gracePeriodEndsAt      DateTime?
  adminNotes                            String?                      @db.Text
  paymentReference                      String?
  paymentMethod                         String?                      @db.VarChar(50)
  activatedById                         String?                      @db.Uuid
  foundersOfferEligible                 Boolean                      @default(false)
  foundersOfferGrantedAt                DateTime?
  foundersOfferSixMonthsDiscountPercent Int?
  foundersOfferAnnualDiscountPercent    Int?
  createdAt                             DateTime                     @default(now())
  updatedAt                             DateTime                     @updatedAt



  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@index([plan, status])
  @@index([currentPeriodEndsAt])
  @@index([gracePeriodEndsAt])
  @@index([activatedById])
}


model SubscriptionPrice {
  id              String                      @id @default(uuid()) @db.Uuid
  countryCode     String                      @db.VarChar(2)
  plan            SubscriptionPlan
  billingInterval SubscriptionBillingInterval
  currencyCode    String                      @db.VarChar(3)
  amount          Decimal                     @db.Decimal(12, 2)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([countryCode, plan, billingInterval])
  @@index([countryCode])
}

model SubscriptionOfferSettings {
  id                       String   @id @default("FOUNDERS_OFFER")
  isActive                 Boolean  @default(true)
  totalEligible            Int      @default(50)
  remainingEligible        Int      @default(50)
  sixMonthsDiscountPercent Int      @default(0)
  annualDiscountPercent    Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}


// ---------------------------------------------------------
// USER IDENTITY & MEMBERSHIP
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  phone        String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  lastActiveAt DateTime?
  version      Int       @default(1)

  memberships                Membership[]
  sentInvitations            ShopInvitation[]     @relation("InvitedByUser")
  createdInstallmentPlans    InstallmentPlan[]    @relation("InstallmentPlanCreator")
  createdInstallmentPayments InstallmentPayment[] @relation("InstallmentPaymentCreator")
  createdExpenses            Expense[]            @relation("ExpenseCreator")
  receivedAutoServiceOrders  ServiceOrder[]       @relation("AutoServiceOrderReceptionist")
  assignedAutoServiceOrders  ServiceOrder[]       @relation("AutoServiceOrderAssignee")
  createdAutoServiceOrders   ServiceOrder[]       @relation("AutoServiceOrderCreator")
  updatedAutoServiceOrders   ServiceOrder[]       @relation("AutoServiceOrderUpdater")
  deliveredAutoServiceOrders ServiceOrder[]       @relation("AutoServiceOrderDeliveredBy")
  closedAutoServiceOrders    ServiceOrder[]       @relation("AutoServiceOrderClosedBy")
  createdAutoServiceOrderHistories ServiceOrderStatusHistory[] @relation("AutoServiceOrderHistoryCreator")
  autoServiceInspections     ServiceInspection[] @relation("AutoServiceInspectionInspector")
  autoServiceLaborLines      ServiceLaborLine[] @relation("AutoServiceLaborTechnician")
  passwordResetTokens        PasswordResetToken[]

  shopId String   @db.Uuid
  role   UserRole @default(OWNER)
  shop   Shop     @relation(fields: [shopId], references: [id])

  @@index([email])
  @@index([lastActiveAt])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model PasswordResetToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique
  requestFingerprint String?
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([requestFingerprint, createdAt])
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  shopId    String           @db.Uuid
  userId    String           @db.Uuid
  role      MembershipRole   @default(TECHNICIAN)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId, status])
  @@index([userId, status])
  @@index([shopId, role])
  @@index([shopId, updatedAt])
}

model ShopInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  shopId          String           @db.Uuid
  name            String?
  email           String
  role            MembershipRole   @default(TECHNICIAN)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?          @db.Uuid
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([email, status])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ---------------------------------------------------------
// BUSINESS DATA MODELS (Fully Multi-Tenant via shopId)
// ---------------------------------------------------------

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  clientGeneratedId String?
  name              String
  phone             String?
  phoneNormalized   String?
  email             String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  version           Int       @default(1)

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairOrders      RepairOrder[]
  vehicles          Vehicle[]      @relation("AutoVehicleCustomer")
  autoServiceOrders ServiceOrder[] @relation("AutoServiceOrderCustomer")
  sales             Sale[]
  invoices         Invoice[]
  installmentPlans InstallmentPlan[]

  @@unique([shopId, clientGeneratedId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

model Supplier {
  id              String    @id @default(uuid()) @db.Uuid
  shopId          String    @db.Uuid
  name            String
  phone           String?
  phoneNormalized String?
  address         String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  version         Int       @default(1)

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairOrders     RepairOrder[]
  repairOrderItems RepairOrderItem[]

  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, phoneNormalized])
  @@index([shopId, updatedAt])
  @@index([shopId, deletedAt])
}

// Purchase receiving is intentionally separate from customer Invoice/Payment.
// Supplier payables are represented by PurchaseInvoice.balanceDue.
// The handwritten SQL migrations remain authoritative for database FKs/RLS;
// these Prisma models mirror the physical tables so validate/generate/types stay aligned.
model PurchaseInvoice {
  id                    String    @id @default(uuid()) @db.Uuid
  shopId                String    @db.Uuid
  supplierId            String?   @db.Uuid
  supplierNameSnapshot  String?
  createdByUserId       String?   @db.Uuid
  supplierInvoiceNumber String?
  invoiceDate           DateTime  @default(now())
  notes                 String?
  currency              String    @db.VarChar(3)
  status                String    @default("DRAFT") @db.VarChar(20)
  subtotal              Decimal   @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal   @default(0) @db.Decimal(14, 2)
  extraCostsTotal       Decimal   @default(0) @db.Decimal(14, 2)
  total                 Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid            Decimal   @default(0) @db.Decimal(14, 2)
  returnAdjustmentTotal Decimal   @default(0) @db.Decimal(14, 2)
  balanceDue            Decimal   @default(0) @db.Decimal(14, 2)
  paymentMethod         String?   @db.VarChar(30)
  paymentAccountType    String?   @db.VarChar(20)
  paymentWalletId       String?   @db.Uuid
  paymentBankAccountId  String?   @db.Uuid
  paymentSourceName     String?
  paymentReference      String?
  postingKey            String?   @db.VarChar(80)
  postingFingerprint    String?   @db.Char(64)
  costAllocatedAt       DateTime?
  postedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  version               Int       @default(1)

  @@unique([shopId, postingKey])
  @@index([shopId, invoiceDate])
  @@index([shopId, status, updatedAt])
  @@index([shopId, supplierId, invoiceDate])
  @@index([shopId, supplierId, supplierInvoiceNumber])
  @@index([shopId, deletedAt])
  @@index([paymentBankAccountId])
}

model PurchaseItem {
  id                         String    @id @default(uuid()) @db.Uuid
  shopId                     String    @db.Uuid
  purchaseInvoiceId          String    @db.Uuid
  inventoryItemId            String?   @db.Uuid
  newItemName                String?
  newItemSku                 String?
  newItemBarcode             String?
  newItemCategoryId          String?   @db.Uuid
  newItemCategory            String?
  newItemDescription         String?
  importedSourceText         String?
  importSourceId             String?   @db.Uuid
  importRowKey               String?   @db.VarChar(120)
  importedPurchaseUnit       String?   @db.VarChar(80)
  matchReviewRequired        Boolean   @default(false)
  compatibilityGroupIds      String[]  @default([]) @db.Uuid
  compatibilityReviewNeeded  Boolean   @default(false)
  updateSalePrice            Boolean   @default(false)
  orderedQuantity            Int
  receivedQuantity           Int       @default(0)
  returnedQuantity           Int       @default(0)
  unitCost                   Decimal   @db.Decimal(18, 6)
  manualExtraCostAllocation  Decimal?  @db.Decimal(14, 2)
  discountAllocation         Decimal?  @db.Decimal(14, 2)
  netMerchandiseValue        Decimal?  @db.Decimal(14, 2)
  netUnitCost                Decimal?  @db.Decimal(18, 6)
  extraCostAllocation        Decimal?  @db.Decimal(14, 2)
  capitalizedLineValue       Decimal?  @db.Decimal(14, 2)
  capitalizedUnitCost        Decimal?  @db.Decimal(18, 6)
  receivedCapitalizedValue   Decimal   @default(0) @db.Decimal(14, 2)
  receivedNetMerchandiseValue Decimal  @default(0) @db.Decimal(14, 2)
  returnedNetMerchandiseValue Decimal  @default(0) @db.Decimal(14, 2)
  salePriceSnapshot          Decimal?  @db.Decimal(14, 2)
  salePriceBeforeSnapshot    Decimal?  @db.Decimal(14, 2)
  lineTotal                  Decimal   @db.Decimal(14, 2)
  sortOrder                  Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([shopId, purchaseInvoiceId, sortOrder])
  @@index([shopId, inventoryItemId])
  @@index([shopId, matchReviewRequired, purchaseInvoiceId])
  @@index([shopId, newItemBarcode])
  @@index([shopId, importSourceId])
}

model PurchasePayment {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @db.Uuid
  purchaseInvoiceId String    @db.Uuid
  createdByUserId   String?   @db.Uuid
  method            String    @db.VarChar(30)
  sourceName        String?
  amount            Decimal   @db.Decimal(14, 2)
  reference         String?
  note              String?
  paidAt            DateTime  @default(now())
  requestKey        String?   @db.VarChar(120)
  requestFingerprint String?  @db.Char(64)
  accountType       String?   @db.VarChar(20)
  walletId          String?   @db.Uuid
  bankAccountId     String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, purchaseInvoiceId, paidAt])
  @@index([bankAccountId])
}

model PurchaseReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @db.Uuid
  purchaseInvoiceId String   @db.Uuid
  createdByUserId   String?  @db.Uuid
  requestKey        String   @db.VarChar(120)
  requestFingerprint String? @db.Char(64)
  receivedAt        DateTime @default(now())
  reference         String?
  note              String?
  createdAt         DateTime @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, purchaseInvoiceId, receivedAt])
}

model PurchaseReceiptItem {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @db.Uuid
  purchaseReceiptId String   @db.Uuid
  purchaseItemId    String   @db.Uuid
  inventoryItemId   String   @db.Uuid
  quantity          Int
  unitCostSnapshot  Decimal  @db.Decimal(18, 6)
  netMerchandiseValue Decimal @db.Decimal(14, 2)
  capitalizedValue  Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  @@unique([purchaseReceiptId, purchaseItemId])
  @@index([shopId, purchaseItemId])
}

model SupplierReturn {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @db.Uuid
  purchaseInvoiceId String   @db.Uuid
  supplierId        String?  @db.Uuid
  createdByUserId   String?  @db.Uuid
  requestKey        String   @db.VarChar(120)
  requestFingerprint String? @db.Char(64)
  reason            String
  reference         String?
  returnedAt        DateTime @default(now())
  baseSettlementValue Decimal @default(0) @db.Decimal(14, 2)
  inventoryValue    Decimal  @default(0) @db.Decimal(14, 2)
  shippingRefundValue Decimal @default(0) @db.Decimal(14, 2)
  settlementAdjustmentValue Decimal @default(0) @db.Decimal(14, 2)
  settlementAdjustmentReason String?
  settlementAdjustedByUserId String? @db.Uuid
  totalValue        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, purchaseInvoiceId, returnedAt])
}

model SupplierReturnItem {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @db.Uuid
  supplierReturnId String   @db.Uuid
  purchaseItemId   String   @db.Uuid
  inventoryItemId  String   @db.Uuid
  quantity         Int
  unitCostSnapshot Decimal  @db.Decimal(18, 6)
  inventoryValue   Decimal  @db.Decimal(14, 2)
  netMerchandiseValue Decimal @db.Decimal(14, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  @@unique([supplierReturnId, purchaseItemId])
  @@index([shopId, purchaseItemId])
}

model SupplierReturnSettlement {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @db.Uuid
  supplierReturnId  String   @db.Uuid
  purchaseInvoiceId String   @db.Uuid
  supplierId        String?  @db.Uuid
  createdByUserId   String?  @db.Uuid
  requestKey        String   @db.VarChar(120)
  requestFingerprint String? @db.Char(64)
  type              String   @db.VarChar(30)
  amount            Decimal  @db.Decimal(14, 2)
  accountType       String?  @db.VarChar(20)
  walletId          String?  @db.Uuid
  bankAccountId     String?   @db.Uuid
  sourceName        String?
  reference         String?
  note              String?
  settledAt         DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, supplierReturnId, settledAt])
  @@index([shopId, supplierId, type, settledAt])
  @@index([bankAccountId])
}

// Private source files/text used only to prepare purchase drafts. No public URL is stored.
model PurchaseImportSource {
  id                   String   @id @default(uuid()) @db.Uuid
  shopId               String   @db.Uuid
  purchaseInvoiceId    String   @db.Uuid
  createdByUserId      String?  @db.Uuid
  sourceType           String   @db.VarChar(20)
  fileName             String?
  mimeType             String?  @db.VarChar(120)
  fileSize             Int?
  pageCount            Int?
  fileData             Bytes?
  textContent          String?
  contentSha256        String   @db.Char(64)
  status               String   @default("UPLOADED") @db.VarChar(24)
  extractionVersion    Int      @default(1)
  extractionProvider   String?  @db.VarChar(80)
  extractedData        Json?
