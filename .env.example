DATABASE_URL="postgresql://postgres:postgres@localhost:5432/massar_auto?schema=public"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Owner"
SEED_SHOP_NAME="Auto Repair Center"

# Authentication (server-only). REQUIRED in production; use a strong random secret of at least 32 characters.
AUTH_SECRET=""

# Super Admin allowlist (server-only, comma-separated emails).
# Fail-closed in every environment: if empty/unset, no account receives Super Admin access.
SUPER_ADMIN_EMAILS=""

# Product analytics / Growth Engineering (PostHog)
# Leave both empty to keep analytics completely disabled.
# The host MUST match the ingest/data region of the PostHog project (for example https://us.i.posthog.com or https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Growth lifecycle automation (disabled until explicitly enabled)
GROWTH_LIFECYCLE_EMAILS_ENABLED="false"
GROWTH_LIFECYCLE_RUN_LIMIT="50"
GROWTH_LIFECYCLE_UNSUBSCRIBE_SECRET=""
GROWTH_LIFECYCLE_FROM_EMAIL=""
CRON_SECRET=""

# Optional: Super Admin Growth Dashboard read access to PostHog. Keep server-only.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_API_HOST=""
POSTHOG_GROWTH_ENVIRONMENT="production"

# Growth experiments are OFF by default; enable deliberately after Preview validation.
GROWTH_EXPERIMENT_ONBOARDING_VALUE_COPY_V1="off"

# Purchase invoice AI extraction (server-only; never expose with NEXT_PUBLIC_*)
# Leave OPENAI_API_KEY empty until configured securely in the server environment.
OPENAI_API_KEY=""
PURCHASE_AI_MODEL="gpt-4.1-mini"
PURCHASE_AI_SHOP_DAILY_LIMIT="6"
PURCHASE_AI_FEATURE_BUDGET_USD="5"
PURCHASE_AI_MAX_OUTPUT_TOKENS="8000"
PURCHASE_AI_PDF_DETAIL="high"
PURCHASE_AI_TIMEOUT_MS="60000"
PURCHASE_AI_FAILED_ATTEMPTS_PER_USER_DAY="3"
PURCHASE_AI_FAILED_ATTEMPTS_PER_SHOP_DAY="12"
# Only required if PURCHASE_AI_MODEL is changed to a model without baked-in pricing.
PURCHASE_AI_INPUT_USD_PER_MILLION=""
PURCHASE_AI_CACHED_INPUT_USD_PER_MILLION=""
PURCHASE_AI_OUTPUT_USD_PER_MILLION=""
# Conservative budget reservation estimates; actual usage settles from OpenAI usage.
PURCHASE_AI_ESTIMATED_INPUT_TOKENS_PER_PDF_PAGE="150000"
PURCHASE_AI_ESTIMATED_INPUT_TOKENS_PER_IMAGE="180000"
PURCHASE_AI_ESTIMATED_PROMPT_TOKENS="5000"

# Purchase source upload/extraction limits
PURCHASE_IMPORT_MAX_FILE_MB="4"
PURCHASE_IMPORT_MAX_PDF_PAGES="3"
PURCHASE_IMPORT_MAX_TEXT_CHARS="40000"
PURCHASE_IMPORT_EXTRACTING_STALE_MINUTES="5"

# Vercel Preview safety: leave false/unset unless DATABASE_URL is an isolated test database.
MASSAR_ALLOW_PREVIEW_DATABASE="false"
